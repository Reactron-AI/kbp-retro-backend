# 환경 변수 템플릿
# 파일을 복사하여 .env로 사용: cp .env.example .env

# ─────────────────────────────────────────────────────────
# 서버 설정
# ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────
# Planner 설정
# ─────────────────────────────────────────────────────────
# mlp, localretro, interretro 중 선택. 서버 프로세스 하나당 모델 하나만 로드되므로
# (RetroStarPlanner가 전역 싱글턴), 여러 모델을 동시에 웹에서 선택 가능하게 하려면
# .env를 복사해서(.env.interretro 등) planner_model만 바꾼 별도 프로세스를 포트만
# 달리해서 띄운다 — 실제 운영도 이렇게 :8000(localretro)/:8002(interretro) 두
# 프로세스로 돈다.
# localretro: USPTO-50K로 학습된 GNN. 체크포인트 설치 + dgl==0.9.1/dgllife==0.2.8
#   (torch==1.9.0과 호환되는 버전) 설치 후 다단계 경로 탐색까지 검증됨. 기본값.
# mlp: 템플릿+롤아웃 기반, 체크포인트가 레포에 포함되어 있어 의존성 추가 없이 동작.
# interretro: torch==2.2.1이 필요해 이 conda env(torch==1.9.0 고정)와는 직접
#   충돌하지만, **별도 conda env(예: kbp-interretro)에서 별도 프로세스로 돌리면
#   문제 없다** — 같은 파이썬 프로세스에서 두 torch 버전을 같이 쓰려는 게 아니라면
#   보류 사유가 아니다.
PLANNER_MODEL=localretro

# GPU ID (-1 = CPU 사용, 0 이상 = 그 인덱스의 GPU 사용)
# GPU를 쓰려면 세 가지가 필요: (1) torch가 그 GPU의 아키텍처를 지원하는 CUDA 빌드로
# 설치되어 있을 것 (예: 오래된 torch==1.9.0 PyPI 기본 빌드는 Ampere(sm_86) 커널이
# 없는 +cu102라 +cu111로 재설치 필요), (2) localretro를 쓴다면 dgl도 GPU 빌드
# (dgl-cu111처럼 CPU 빌드와 패키지명 자체가 다름)로 설치, (3) gunicorn 등으로 여러
# 워커를 fork하지 않을 것 — CUDA 컨텍스트가 fork 후 깨지는 경우가 있어, 이 서비스는
# 이미 단일 프로세스가 강제되어 있으므로(아래 참고) plain uvicorn으로 실행할 것.
GPU_ID=-1

# 계획 파라미터
ITERATIONS=500
EXPANSION_TOPK=50

# ─────────────────────────────────────────────────────────
# CORS 설정 (프론트엔드 URL, 쉼표로 분리)
# ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8080

# ─────────────────────────────────────────────────────────
# API 키 (공개 노출 전 필수 설정)
# ─────────────────────────────────────────────────────────
# 비워두면 인증 없이 동작(로컬 개발용). 외부에 공개할 때는 반드시 채울 것.
# 프론트엔드 Settings에서 같은 값을 입력해야 함.
API_KEY=

# ─────────────────────────────────────────────────────────
# 출력 디렉토리
# ─────────────────────────────────────────────────────────
OUTPUT_DIR=./output
ROUTE_SAVE_DIR=./output/routes

# ─────────────────────────────────────────────────────────
# LocalRetro 설정
# ─────────────────────────────────────────────────────────
# root/model_path/data_dir은 기본 경로(KBP-main/LocalRetro/...)와 일치해서 비워둬도 됨.
# config_path만 업로드된 실제 경로가 기본값(data/configs/)과 다름(data/config/, s 없음)
# 이라 명시해야 함:
# LOCALRETRO_ROOT=/path/to/LocalRetro
# LOCALRETRO_MODEL_PATH=/path/to/model
LOCALRETRO_CONFIG_PATH=../LocalRetro/data/config/default_config.json
# LOCALRETRO_DATA_DIR=/path/to/data

# ─────────────────────────────────────────────────────────
# InterRetro 설정 (PLANNER_MODEL=interretro일 때만 필요 — torch==2.2.1 요구,
# 별도 conda env에서 별도 프로세스로 실행할 것. 체크포인트는 이 공개 레포에는
# 포함되어 있지 않다.)
# ─────────────────────────────────────────────────────────
# INTERRETRO_ROOT=/path/to/InterRetro
# 실제 배포에서 쓰는 체크포인트 경로 (기본값은 폴더명에 ':'가 들어가 있어 불일치):
# INTERRETRO_CHECKPOINT=../InterRetro/InterRetro/experiments/default0429-075316-s51/models_epoch4_it0.pth
